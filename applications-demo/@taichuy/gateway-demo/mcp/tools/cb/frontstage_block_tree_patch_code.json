      "page_id",
      "source_revision",
      "applied_edits",
      "changes",
      "diff_truncated"
    ],
    "properties": {
      "changes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "edit_index",
            "start_line",
            "start_column",
            "end_line",
            "end_column",
            "old_text",
            "new_text",
            "truncated"
          ],
          "properties": {
            "end_line": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "new_text": {
              "type": "string"
            },
            "old_text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "edit_index": {
              "type": "integer",
              "minimum": 0
            },
            "end_column": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "start_line": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "start_column": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        }
      },
      "page_id": {
        "type": "string"
      },
      "block_id": {
        "type": "string"
      },
      "applied_edits": {
        "type": "integer",
        "minimum": 0
      },
      "diff_truncated": {
        "type": "boolean"
      },
      "source_revision": {
        "type": "string"
      }
    }
  },
  "input_mapping": {
    "mappings": [
      {
        "required": true,
        "mcp_param": "page_id",
        "description": "目标页面稳定标识。",
        "interface_param": "page_id"
      },
      {
        "required": true,
        "mcp_param": "block_id",
        "description": "目标区块公开稳定标识。",
        "interface_param": "block_id"
      },
      {
        "required": true,
        "mcp_param": "edits",
        "description": "1–100 项 {start_line,start_column,end_line,end_column,replacement}，1-based Unicode 标量坐标，范围左闭右开；空 replacement 删除，相同起止位置插入。",
        "interface_param": "edits"
      },
      {

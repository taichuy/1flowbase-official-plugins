{
  "tool_id": "frontstage_block_tree_patch_code",
  "name": "按坐标修改区块源码",
  "short_description": "原子修改区块源码的坐标范围，返回修订号和有限差异。",
  "full_description": "先用 frontstage_block_tree_search_code 或 frontstage_block_tree_get_code_fragment 定位并获取修订号。同批编辑均针对原始源码且不得重叠；任何一项失败则整批不写入。返回 changes 的坐标针对原始源码，前后文本合计最多 8000 个 Unicode 标量，检查 diff_truncated。冲突后重新读取再构造编辑；不直接重试旧批次。",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "patch_frontstage_block_node_code"
  },
  "parameter_schema_snapshot": {
    "type": "object",
    "required": [
      "path",
      "body"
    ],
    "properties": {
      "body": {
        "type": "object",
        "required": [
          "expected_source_revision",
          "edits"
        ],
        "properties": {
          "edits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_line",
                "start_column",
                "end_line",
                "end_column",
                "replacement"
              ],
              "properties": {
                "end_line": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                },
                "end_column": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                },
                "start_line": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                },
                "replacement": {
                  "type": "string"
                },
                "start_column": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "expected_source_revision": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "path": {
        "type": "object",
        "required": [
          "page_id",
          "block_id"
        ],
        "properties": {
          "page_id": {
            "type": "string"
          },
          "block_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "result_schema_snapshot": {

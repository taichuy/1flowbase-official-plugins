{
  "tool_id": "chatgpt_import_file",
  "name": "chatgpt_import_file",
  "short_description": "将 ChatGPT 对话中生成或选中的文件保存到 1flowbase 文件表，返回持久文件记录。",
  "full_description": "在 mcp_call 外层的 file 传入 ChatGPT 提供的文件引用，arguments 传 {} 或包含 file_table_id；系统会将 file 注入本工具参数。也可在 arguments.file 直接传入完整引用，两处同时提供时必须一致。download_url 必须是可访问的下载地址，sandbox:/ 路径不能直接作为下载地址；file_id 是 ChatGPT 临时文件标识，不是保存后的 record.id。",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "import_remote_file"
  },

{
  "tool_id": "application_log_records_query",
  "name": "query_application_log_records",
  "short_description": "组合筛选当前工作区可读的 Agent Flow 与采集记录，返回来源、模型、用量费用和分页游标。",
  "full_description": "二级检索入口：可跨当前工作区有权访问的应用查询，application_ids 省略表示全部可读应用，空数组表示无应用。先用 keyword 或已发现的 filter 筛选，默认按 started_at 排序。返回摘要中的 application_id、record_id 用于详情和三级客户端日志；next_cursor 仅在筛选和排序不变时续页。检索数量不是统计总数，一级统计使用 ai_chat_logs_statistics。",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "query_log_records"
  },

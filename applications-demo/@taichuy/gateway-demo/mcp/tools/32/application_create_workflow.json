                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Required for schedule triggers; IANA timezone name."
                  },
                  "http_method": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "GET",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE",
                          "HEAD",
                          "OPTIONS"
                        ],
                        "type": "string",
                        "description": "Extension HTTP method. Defaults to POST."
                      }
                    ]
                  },
                  "input_payload": {
                    "description": "Optional schedule defaults keyed by Workflow Start input field key."
                  },
                  "response_mode": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "sync",
                          "async"
                        ],
                        "type": "string",
                        "description": "Extension response mode: sync or async. Defaults to sync."
                      }
                    ]
                  }
                },
                "description": "Optional initial config for the selected Workflow trigger. Schedule creation is always\ndisabled until its schedule resource is enabled with PUT.",
                "additionalProperties": false
              }
            ]
          }
        },
        "description": "Creates exactly one Agent Flow or Workflow Application."
      }
    },
    "additionalProperties": false
  },

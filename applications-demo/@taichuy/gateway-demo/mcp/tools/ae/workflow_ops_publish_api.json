              "extension": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "slug",
                      "method",
                      "response_mode"
                    ],
                    "properties": {
                      "slug": {
                        "type": "string",
                        "description": "Route template below /api/ex/ without a leading slash. Workflow Start path-source keys must\nmatch every {placeholder} exactly."
                      },
                      "method": {
                        "enum": [
                          "GET",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE",
                          "HEAD",
                          "OPTIONS"
                        ],
                        "type": "string",
                        "description": "HTTP method accepted by the published extension interface."
                      },
                      "response_mode": {
                        "enum": [
                          "sync",
                          "async"
                        ],
                        "type": "string",
                        "description": "sync waits for a result up to Workflow Start sync_timeout_ms; async returns an accepted run."
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "description": "Agent Flow request/output mapping or Workflow extension publication mapping."
          },
          "api_enabled": {
            "type": "boolean",
            "description": "Enables invocation for the new active publication. Workflow extension invocation uses the\nnormal /api/ex/{slug} interface and never requires an Application API Key."
          }
        }

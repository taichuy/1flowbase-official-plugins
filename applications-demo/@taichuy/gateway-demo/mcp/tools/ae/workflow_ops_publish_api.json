{
  "tool_id": "workflow_ops_publish_api",
  "name": "publish_workflow_extension",
  "short_description": "冻结当前 Workflow 草稿并发布普通 /api/ex/ extension 接口。",
  "full_description": "发布使用当前 draft 生成不可变 flow version。mapping.extension 定义 /api/ex/ 下的 slug、method、response_mode；extension parameters 的 target 必须引用 Workflow Start 输入字段，output selector 必须引用当前编排可输出的数据。Workflow extension 不使用 Application API Key，也不进入 Agent Flow AI Gateway。",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "publish_application_api"
  },

{
  "tool_id": "application_create_agent_logs",
  "name": "创建日志应用",
  "short_description": "创建 Agent Logs 应用，应用类型已固定。",
  "full_description": "创建专门接收与查看客户端日志的 agent_logs 应用。name、description 描述日志来源和用途；完成后用 application_get 读取详情。它不是 Agent Flow，不使用工作流编排或发布入口。",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "create_application"
  },
  "parameter_schema_snapshot": {
    "type": "object",
    "required": [
      "body"
    ],
    "properties": {
      "body": {
        "type": "object",
        "required": [
          "application_type",
          "name",
          "description"
        ],
        "properties": {
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "icon_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "icon_background": {
            "type": [
              "string",
              "null"
            ]
          },
          "application_type": {
            "enum": [
              "agent_logs",
              "agent_flow",
              "workflow"
            ],
            "type": "string",
            "description": "Closed Application family. Agent Flow and Workflow have different boundary nodes and API\npublication semantics."
          },
          "workflow_trigger_type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "enum": [
                  "extension",
                  "schedule"
                ],
                "type": "string",
                "description": "Applies only to workflow. Defaults to extension when omitted; Agent Flow ignores no trigger\nvalue and rejects trigger configuration."
              }
            ]
          },
          "workflow_trigger_config": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "cron": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Required for schedule triggers; standard cron expression."
                  },
                  "subpath": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Required for extension triggers; route template below /api/ex/ without leading slash."
                  },
                  "timezone": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Required for schedule triggers; IANA timezone name."
                  },
                  "http_method": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "GET",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE",
                          "HEAD",
                          "OPTIONS"
                        ],
                        "type": "string",
                        "description": "Extension HTTP method. Defaults to POST."
                      }
                    ]
                  },
                  "input_payload": {
                    "description": "Optional schedule defaults keyed by Workflow Start input field key."
                  },
                  "response_mode": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "enum": [
                          "sync",
                          "async"
                        ],
                        "type": "string",
                        "description": "Extension response mode: sync or async. Defaults to sync."
                      }
                    ]
                  }
                },
                "description": "Optional initial config for the selected Workflow trigger. Schedule creation is always\ndisabled until its schedule resource is enabled with PUT.",
                "additionalProperties": false
              }
            ]
          }
        },
        "description": "Creates exactly one Agent Flow or Workflow Application."
      }
    },
    "additionalProperties": false
  },

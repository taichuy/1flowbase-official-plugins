{
  "tool_id": "ai_chat_logs_conversation_messages",
  "name": "读取对话消息",
  "short_description": "按应用和外部 conversation_id 分页读取历史对话消息。",
  "full_description": "id 是 application_id，conversation_id 使用日志中的真实外部会话标识。before/after 是运行游标，around_run_id 用于定位某次运行附近的消息；默认每页 5 次运行。需要客户端协议或工具步骤时使用 record_id 进入 client_logs，conversation_id、record_id、run_id 不可混用。",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "list_application_conversation_messages"
  },
  "parameter_schema_snapshot": {
    "type": "object",
    "required": [
      "path"
    ],
    "properties": {
      "path": {
        "type": "object",
        "required": [
          "id",
          "conversation_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Application id"
          },
          "conversation_id": {
            "type": "string",
            "description": "External conversation id"
          }
        },
        "additionalProperties": false
      },
      "query": {
        "type": "object",
        "properties": {
          "after": {
            "type": "string",
            "description": "Load runs after this cursor run id"
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "description": "Page size, defaults to 5"
          },
          "before": {
            "type": "string",
            "description": "Load runs before this cursor run id"
          },
          "around_run_id": {
            "type": "string",
            "description": "Flow run id to center the page around"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },

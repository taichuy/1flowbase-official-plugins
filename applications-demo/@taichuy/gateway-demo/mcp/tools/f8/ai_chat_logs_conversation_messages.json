              "type": [
                "string",
                "null"
              ],
              "description": "Where this item's visible output came from: a formal provider output\nitem, the call's persisted answer, its error, nothing at all, or no\noutput claim (`None` for prompts, context and tool results)."
            },
            "context_source": {
              "type": [
                "string",
                "null"
              ],
              "description": "Set for the system/developer context entries that open the conversation.\nThey carry the layer the context came from; the console renders them as\nthe first turns instead of a separate panel."
            },
            "can_open_detail": {
              "type": "boolean"
            }
          }
        },
        "description": "Conversation turns, preceded by the system/developer context entries in\nforce for this run. Context is part of every page, so paging never hides\nit and the console needs no separate surface for it."

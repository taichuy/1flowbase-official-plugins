{
  "tool_id": "plugin.google-search-console.search_analytics_query",
  "name": "search_analytics_query",
  "short_description": "Query Google Search Analytics",
  "full_description": "Query clicks, impressions, CTR, and average position across dimensions (query, page, date, country, device, searchAppearance) with optional filters and pagination.",
  "execution_target": {
    "kind": "interface_wrapper",
    "interface_id": "google-search-console.analytics.query"
  },
  "parameter_schema_snapshot": {
    "type": "object",
    "properties": {
      "account_id": {
        "type": "string",
        "minLength": 1,
        "description": "Connected Google account ID. Obtain it from accounts_list."
      },
      "site_url": {
        "type": "string",
        "minLength": 1,
        "description": "GSC property URL, e.g. \"https://1flowbase.taichuy.com/\" (with trailing slash) or \"sc-domain:example.com\"."
      },
      "start_date": {
        "type": "string",
        "minLength": 1,
        "description": "Start date in YYYY-MM-DD format."
      },
      "end_date": {
        "type": "string",
        "minLength": 1,
        "description": "End date in YYYY-MM-DD format."
      },
      "dimensions": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "country",
            "device",
            "page",
            "query",
            "searchAppearance",
            "date"
          ]
        },
        "description": "Dimensions to group results by."
      },
      "type": {
        "type": "string",
        "enum": [
          "web",
          "image",
          "video",
          "news",
          "discover",
          "googleNews"
        ],
        "description": "Search type filter (default web)."
      },
      "aggregation_type": {
        "type": "string",
        "enum": [
          "auto",
          "byPage",
          "byProperty",
          "byNewsShowcasePanel"
        ]
      },
      "dimension_filter_groups": {
        "type": "array",
        "description": "Optional Search Console API dimensionFilterGroups array.",
        "items": {
          "type": "object",
          "properties": {
            "groupType": {
              "type": "string",
              "enum": [
                "and"
              ]
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dimension": {
                    "type": "string",
                    "enum": [
                      "country",
                      "device",
                      "page",
                      "query",
                      "searchAppearance"
                    ]
                  },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "contains",
                      "equals",
                      "notContains",
                      "notEquals",
                      "includingRegex",
                      "excludingRegex"
                    ]
                  },
                  "expression": {
                    "type": "string"
                  }
                },
                "required": [
                  "dimension",
                  "operator",
                  "expression"
                ]
              }
            }
          }
        }
      },
      "row_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25000,
        "description": "Max rows to return (1-25000, default 1000)."
      },
      "start_row": {
        "type": "integer",
        "minimum": 0,
        "description": "Zero-based pagination offset."
      },
      "data_state": {
        "type": "string",
        "enum": [
          "final",
          "all"
        ],
        "description": "Use \"all\" to include fresh unfinalized data."
      }
    },
    "required": [
      "account_id",
      "site_url",
      "start_date",
      "end_date"
    ],
    "additionalProperties": false
  },

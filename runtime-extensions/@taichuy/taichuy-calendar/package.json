{
  "name": "@taichuy/taichuy-calendar",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "Standalone Taichuy lunar calendar, almanac, birth information, ZiWei and Bazi runtime extension",
  "source": "src/index.tsx",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./_assets/ui/browser.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:package": "node scripts/build.mjs && node scripts/build-page-template.mjs && node scripts/build-runtime.mjs && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "fixtures:prepare": "node scripts/build-fixtures.mjs",
    "fixtures:components": "node scripts/run-component-fixtures.mjs",
    "build:template": "node scripts/build-page-template.mjs",
    "test:contracts": "node --test scripts/_tests/*.test.mjs"
  },
  "dependencies": {
    "lunar-typescript": "1.8.6",
    "tyme4ts": "1.3.9",
    "iztro": "2.5.3",
    "astronomy-engine": "2.1.19",
    "china-division": "2.7.0",
    "copy-to-clipboard": "3.3.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "antd": "6.6.2",
    "dayjs": "^1.11.20",
    "@ant-design/icons": "^6.3.4",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/model-pricing/v2/source.schema.json",
  "title": "1flowbase model pricing source v2",
  "type": "object",
  "required": [
    "id",
    "provider_code",
    "upstream_model_id",
    "input_token_unit_size",
    "input_token_unit_price",
    "output_token_unit_size",
    "output_token_unit_price",
    "cache_hit_token_unit_size",
    "cache_hit_token_unit_price",
    "currency_code",
    "effective_from",
    "timezone",
    "weekday_mask",
    "priority",
    "enabled",
    "extensions",
    "cache_write_token_unit_size",
    "cache_write_token_unit_price",
    "rules",
    "schema_version",
    "effective_to",
    "local_time_start",
    "local_time_end"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "provider_code": {
      "type": "string",
      "minLength": 1
    },
    "upstream_model_id": {
      "type": "string",
      "minLength": 1
    },
    "input_token_unit_size": {
      "type": "integer",
      "minimum": 1
    },
    "input_token_unit_price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
    },
    "output_token_unit_size": {
      "type": "integer",
      "minimum": 1
    },
    "output_token_unit_price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
    },
    "cache_hit_token_unit_size": {
      "type": "integer",
      "minimum": 1
    },
    "cache_hit_token_unit_price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
    },
    "currency_code": {
      "const": "USD"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "weekday_mask": {
      "type": "integer",
      "minimum": 1,
      "maximum": 127
    },
    "local_time_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "time"
    },
    "local_time_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "time"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object"
    },
    "cache_write_token_unit_size": {
      "type": "integer",
      "minimum": 1
    },
    "cache_write_token_unit_price": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "overrides"
        ],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "input_tokens": {
                "type": "object",
                "required": [
                  "operator",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "operator": {
                    "enum": [
                      "gt",
                      "gte"
                    ]
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "cache_write_ttl_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "effective_from": {
                "type": "string",
                "format": "date-time"
              },
              "effective_to": {
                "type": "string",
                "format": "date-time"
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "weekday_mask": {
                "type": "integer",
                "minimum": 1,
                "maximum": 127
              },
              "local_time_start": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
              },
              "local_time_end": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
              }
            },
            "dependentRequired": {
              "local_time_start": [
                "local_time_end",
                "timezone"
              ],
              "local_time_end": [
                "local_time_start",
                "timezone"
              ]
            }
          },
          "overrides": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "input_token_unit_size": {
                "type": "integer",
                "minimum": 1
              },
              "input_token_unit_price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
              },
              "output_token_unit_size": {
                "type": "integer",
                "minimum": 1
              },
              "output_token_unit_price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
              },
              "cache_hit_token_unit_size": {
                "type": "integer",
                "minimum": 1
              },
              "cache_hit_token_unit_price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
              },
              "cache_write_token_unit_size": {
                "type": "integer",
                "minimum": 1
              },
              "cache_write_token_unit_price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "when": {
                  "required": [
                    "cache_write_ttl_seconds"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "overrides": {
                  "propertyNames": {
                    "enum": [
                      "cache_write_token_unit_size",
                      "cache_write_token_unit_price"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "schema_version": {
      "const": "1flowbase.model-pricing-source/v2"
    }
  },
  "additionalProperties": false
}

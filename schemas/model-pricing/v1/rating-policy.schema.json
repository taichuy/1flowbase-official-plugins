{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/model-pricing/v1/rating-policy.schema.json",
  "title": "1flowbase model rating policy v1",
  "oneOf": [
    {
      "type": "object",
      "maxProperties": 0
    },
    {
      "type": "object",
      "required": ["schema_version", "type", "tiers"],
      "properties": {
        "schema_version": { "const": "1flowbase.model-rating-policy/v1" },
        "type": { "const": "input_token_tiers" },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["when", "rates"],
            "properties": {
              "when": {
                "type": "object",
                "required": ["operator", "value"],
                "properties": {
                  "operator": { "enum": ["gt", "gte"] },
                  "value": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "rates": {
                "type": "object",
                "required": ["input", "output", "cache_hit"],
                "properties": {
                  "input": { "$ref": "#/$defs/tokenRate" },
                  "output": { "$ref": "#/$defs/tokenRate" },
                  "cache_hit": { "$ref": "#/$defs/tokenRate" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "tokenRate": {
      "type": "object",
      "required": ["unit_size", "unit_price"],
      "properties": {
        "unit_size": { "type": "integer", "minimum": 1 },
        "unit_price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]{1,18})?$"
        }
      },
      "additionalProperties": false
    }
  }
}

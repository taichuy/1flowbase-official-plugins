{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/model-pricing/v1/source.schema.json",
  "title": "1flowbase model pricing source v1",
  "type": "object",
  "required": ["schema_version", "provider_code", "upstream_model_id", "currency_code", "rules"],
  "properties": {
    "schema_version": { "const": "1flowbase.model-pricing-source/v1" },
    "provider_code": { "type": "string", "minLength": 1 },
    "upstream_model_id": { "type": "string", "minLength": 1 },
    "currency_code": { "const": "USD" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input_token_unit_size", "input_token_unit_price", "output_token_unit_size", "output_token_unit_price", "cache_hit_token_unit_size", "cache_hit_token_unit_price", "effective_from", "effective_to", "timezone", "weekday_mask", "local_time_start", "local_time_end", "priority", "enabled", "extensions"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "input_token_unit_size": { "type": "integer", "minimum": 1 },
          "input_token_unit_price": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,18})?$" },
          "output_token_unit_size": { "type": "integer", "minimum": 1 },
          "output_token_unit_price": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,18})?$" },
          "cache_hit_token_unit_size": { "type": "integer", "minimum": 1 },
          "cache_hit_token_unit_price": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,18})?$" },
          "effective_from": { "type": "string", "format": "date-time" },
          "effective_to": { "type": ["string", "null"], "format": "date-time" },
          "timezone": { "type": "string", "minLength": 1 },
          "weekday_mask": { "type": "integer", "minimum": 1, "maximum": 127 },
          "local_time_start": { "type": ["string", "null"], "format": "time" },
          "local_time_end": { "type": ["string", "null"], "format": "time" },
          "priority": { "type": "integer", "minimum": 0 },
          "enabled": { "type": "boolean" },
          "extensions": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

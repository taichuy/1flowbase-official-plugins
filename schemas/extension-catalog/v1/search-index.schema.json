{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/extension-catalog/v1/search-index.schema.json",
  "title": "1flowbase extension catalog search index v1",
  "type": "object",
  "required": ["schema_version", "category", "generated_at", "source_fingerprint", "entries"],
  "properties": {
    "schema_version": { "const": "1flowbase.extension-catalog-search/v1" },
    "category": {
      "enum": ["agent-flow", "capability-plugins", "host-extensions", "i18n", "mcp", "runtime-extensions"]
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "organization", "artifact", "version", "description", "host_version_requirement", "source", "signature", "checksum", "slot_codes", "keywords", "catalog_page"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["agent-flow", "capability-plugins", "host-extensions", "i18n", "mcp", "runtime-extensions"]
          },
          "organization": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "host_version_requirement": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["kind", "locator"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          },
          "signature": { "type": ["object", "null"] },
          "checksum": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            ]
          },
          "slot_codes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "catalog_page": {
            "type": "object",
            "required": ["page", "cursor", "checksum", "locator"],
            "properties": {
              "page": { "type": "integer", "minimum": 1 },
              "cursor": { "type": "string", "minLength": 1 },
              "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "locator": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/extension-catalog/v1/catalog.schema.json",
  "title": "1flowbase extension catalog v1",
  "oneOf": [
    { "$ref": "#/$defs/index" },
    { "$ref": "#/$defs/page" }
  ],
  "$defs": {
    "category": {
      "enum": [
        "agent-flow",
        "capability-plugins",
        "host-extensions",
        "i18n",
        "mcp",
        "runtime-extensions"
      ]
    },
    "locator": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "organization",
        "artifact",
        "version",
        "description",
        "slot_codes",
        "keywords",
        "host_version_requirement",
        "source",
        "signature",
        "checksum",
        "download_locator",
        "catalog_page"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "organization": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "slot_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "host_version_requirement": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["kind", "locator"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "locator": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "signature": { "type": ["object", "null"] },
        "checksum": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "download_locator": { "$ref": "#/$defs/locator" },
        "catalog_page": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pageReference": {
      "type": "object",
      "required": ["page", "cursor", "entry_count", "checksum", "locator"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "string", "minLength": 1 },
        "entry_count": { "type": "integer", "minimum": 0 },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "locator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "required": ["schema_version", "category", "generated_at", "page_size", "total_entries", "first_page", "search_index", "pages"],
      "properties": {
        "schema_version": { "const": "1flowbase.extension-catalog/v1" },
        "category": { "$ref": "#/$defs/category" },
        "generated_at": { "type": "string", "format": "date-time" },
        "page_size": { "type": "integer", "minimum": 1 },
        "total_entries": { "type": "integer", "minimum": 0 },
        "first_page": {
          "type": "object",
          "required": ["page", "cursor", "locator"],
          "properties": {
            "page": { "const": 1 },
            "cursor": { "const": "start" },
            "locator": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "search_index": {
          "type": "object",
          "required": ["schema_version", "entry_count", "checksum", "locator"],
          "properties": {
            "schema_version": { "const": "1flowbase.extension-catalog-search/v1" },
            "entry_count": { "type": "integer", "minimum": 0 },
            "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "locator": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pageReference" } }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["schema_version", "category", "page", "cursor", "next_cursor", "next_page_locator", "entries"],
      "properties": {
        "schema_version": { "const": "1flowbase.extension-catalog/v1" },
        "category": { "$ref": "#/$defs/category" },
        "page": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "string", "minLength": 1 },
        "next_cursor": { "type": ["string", "null"] },
        "next_page_locator": { "type": ["string", "null"] },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/extension-catalog/v1/source-entry.schema.json",
  "title": "Canonical extension catalog source entry",
  "description": "Place this file at <category>/@<organization>/<artifact>/catalog-entry.json.",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "host_version_requirement",
    "source",
    "signature",
    "checksum",
    "download_locator"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "slot_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "host_version_requirement": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["kind", "locator"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "signature": { "type": ["object", "null"] },
    "checksum": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      ]
    },
    "download_locator": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

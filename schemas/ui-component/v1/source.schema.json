{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/ui-component/v1/source.schema.json",
  "title": "1flowbase UI component source v1",
  "type": "object",
  "required": ["schema_version", "component_code", "name", "description", "import_code", "source_code", "origin", "source", "group", "upstream", "version", "keywords", "updated_at"],
  "properties": {
    "schema_version": { "const": "1flowbase.ui-component-source/v1" },
    "component_code": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "import_code": { "type": "string", "minLength": 1 },
    "source_code": { "type": "string", "minLength": 1 },
    "origin": { "const": "official" },
    "source": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "group": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "upstream": {
      "type": "object",
      "required": ["identity", "version"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "keywords": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

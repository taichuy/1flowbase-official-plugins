{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/ui-component/v1/catalog-source.schema.json",
  "title": "1flowbase UI component catalog source v1",
  "type": "object",
  "required": ["schema_version", "catalog_version", "generated_at", "page_size"],
  "properties": {
    "schema_version": { "const": "1flowbase.ui-component-catalog-source/v1" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "page_size": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}

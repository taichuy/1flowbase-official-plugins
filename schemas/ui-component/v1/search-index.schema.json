{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1flowbase.com/schemas/ui-component/v1/search-index.schema.json",
  "title": "1flowbase UI component search index v1",
  "type": "object",
  "required": ["schema_version", "catalog_version", "generated_at", "source_fingerprint", "entries"],
  "properties": {
    "schema_version": { "const": "1flowbase.ui-component-catalog-search/v1" },
    "catalog_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_code", "name", "description", "origin", "source", "group", "upstream", "version", "keywords", "catalog_page"],
        "properties": {
          "component_code": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "origin": { "const": "official" },
          "source": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "upstream": {
            "type": "object",
            "required": ["identity", "version"],
            "properties": {
              "identity": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "version": { "type": "string", "minLength": 1 },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "catalog_page": { "$ref": "#/$defs/pageReference" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "pageReference": {
      "type": "object",
      "required": ["page", "cursor", "checksum", "locator"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "cursor": { "type": "string" },
        "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "locator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
